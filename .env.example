# Environment variable NAMES used by the site. Never put real values here —
# set them in Vercel → Project → Settings → Environment Variables
# (Production + Preview).

# --- Stripe -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend: order + download emails) ----------------------------
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
RESEND_AUDIENCE_ID=
ORDER_NOTIFY_TO=
CONTACT_TO=

# --- Sanity ---------------------------------------------------------------
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_TOKEN=

# --- Funnel, Brevo + PDF delivery (2026-11 restructure) -------------------
# Brevo API key (Brevo → SMTP & API → API keys).
BREVO_API_KEY=
# Numeric list ids printed by `node scripts/brevo-setup.js`:
#   "Routine sample" (funnel leads), "Customers", "Newsletter".
BREVO_LIST_ROUTINE=
BREVO_LIST_CUSTOMERS=
BREVO_LIST_NEWSLETTER=
# Numeric id of the double opt-in confirmation template (also printed by the script).
BREVO_DOI_TEMPLATE_ID=
# Long random string that signs offer + download links. If missing,
# STRIPE_WEBHOOK_SECRET is used. Changing it invalidates links already sent.
FUNNEL_SECRET=
# Set automatically when a (private) Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Optional: base URL used in emailed links (defaults to https://cadomalo.com
# in production and the branch URL on previews).
SITE_URL=
